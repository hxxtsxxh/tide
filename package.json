{
  "name": "ripple",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "check": "tsc --noEmit",
    "test": "node --conditions=react-server --test \"tests/**/*.test.ts\" \"tests/**/*.test.mjs\"",
    "evaluate": "node scripts/evaluate.mjs",
    "test:tavily": "node --conditions=react-server --test tests/tavily-extract.test.mjs tests/tavily-integration.test.ts",
    "test:mcp": "node --test packages/ripple-mcp/tests/*.test.mjs",
    "package:integrations": "python3 packages/ripple-mcp/scripts/package-kit.py --output public/downloads/ripple-agent-kit.zip"
  },
  "dependencies": {
    "motion": "12.23.12",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
