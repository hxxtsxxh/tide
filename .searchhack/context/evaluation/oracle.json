        "event": {
          "kind": "source_fetch_failed",
          "source_id": "s-cap"
        }
      },
      "expected_http": 200,
      "expected": {
        "eq": {
          "status": "partial"
        },
        "set_eq": {
          "result.affected_answer_ids": [
            "a-workshop",
            "a-keynote"
          ],
          "result.unknown_answer_ids": [
            "a-workshop",
            "a-keynote"
          ]
        },
        "contains": {}
      }
    },
    {
