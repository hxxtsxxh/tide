        "answers": [
          {
            "id": "a-workshop",
            "depends_on": [
              "a-keynote"
            ]
          },
          {
            "id": "a-keynote",
            "depends_on": [
              "a-workshop"
            ]
          }
        ]
      },
      "expected_http": 400,
      "expected": {
        "eq": {},
        "set_eq": {},
        "contains": {}
      }
    },
    {
      "id": "R08",
      "fixture_id": "r-main",
      "query": "A fact unused by any answer changes.",
