{
  "purpose": "test assertions only; NEVER runtime input",
  "cases": [
    {
      "id": "R01",
      "fixture_id": "r-main",
      "query": "Recheck the workshop plan after capacity changes.",
      "input": {},
      "expected_http": 200,
      "expected": {
        "eq": {
          "result.history_preserved": true
        },
        "set_eq": {
          "result.affected_answer_ids": [
            "a-workshop",
            "a-keynote"
          ],
          "result.recomputed_answer_ids": [
            "a-workshop",
            "a-keynote"
          ],
          "result.reused_answer_ids": [
            "a-doors"
          ]
        },
        "contains": {}
      }
    },
    {
      "id": "R02",
      "fixture_id": "r-main",
      "query": "Ignore cosmetic source formatting changes.",
      "input": {
        "event": {
          "kind": "source_text_changed",
          "source_id": "s-cap",
          "new_text": "The workshop room seats 120 guests.\nThis is an authored test fact.",
          "semantic_value": 120
        }
      },
      "expected_http": 200,
      "expected": {
        "eq": {},
        "set_eq": {
          "result.affected_answer_ids": [],
          "result.recomputed_answer_ids": [],
          "result.reused_answer_ids": [
            "a-workshop",
            "a-keynote",
            "a-doors"
          ]
        },
        "contains": {}
      }
    },
    {
      "id": "R03",
      "fixture_id": "r-main",
      "query": "A refresh returns the same fact.",
      "input": {
        "event": {
          "kind": "fact_changed",
          "fact_id": "f-cap",
          "new_value": 120
        }
      },
      "expected_http": 200,
      "expected": {
        "eq": {},
        "set_eq": {
          "result.affected_answer_ids": [],
          "result.recomputed_answer_ids": []
        },
        "contains": {}
      }
    },
    {
      "id": "R04",
      "fixture_id": "r-main",
      "query": "Capacity source cannot be refreshed.",
