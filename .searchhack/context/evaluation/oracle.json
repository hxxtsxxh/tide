      "input": {
        "facts": [
          {
            "id": "f-cap",
            "value": 120,
            "support_sets": [
              [
                "s-cap"
              ],
              [
                "s-backup"
              ]
            ]
          },
          {
            "id": "f-time",
            "value": "10:00",
            "support_sets": [
              [
                "s-time"
              ]
            ]
          }
        ],
        "event": {
          "kind": "source_deleted",
          "source_id": "s-cap"
        }
      },
      "expected_http": 200,
      "expected": {
        "eq": {},
        "set_eq": {
          "result.unknown_answer_ids": [],
          "result.recomputed_answer_ids": []
        },
        "contains": {}
      }
    },
    {
      "id": "R06",
      "fixture_id": "r-main",
      "query": "Only supporting source is deleted.",
      "input": {
        "event": {
          "kind": "source_deleted",
          "source_id": "s-cap"
        }
      },
      "expected_http": 200,
      "expected": {
        "eq": {
          "status": "partial"
        },
        "set_eq": {
          "result.unknown_answer_ids": [
